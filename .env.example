# FIT-Connect TEST environment configuration
# Portal: https://portal.auth-testing.fit-connect.fitko.dev
# Copy this file to .env and fill in the values there. Never commit .env (it is git-ignored);
# never put real credentials in this example file.

# --- Sender role: online service (Typ C) that SENDS Meldeauskunft-Anfragen -------------------
# OAuth client credentials of the sending system
SENDER_CLIENT_ID=
SENDER_CLIENT_SECRET=
# The sender's own destination (Zustellpunkt) id — every party in FIT-Connect is a destination.
# The SDK requires it to exist and be of type "Onlinedienst" (C).
SENDER_DESTINATION_ID=

# --- Receiver role: administrative system (Typ A) simulating the Einwohnermeldeamt -----------
# OAuth client credentials of the receiving system
RECEIVER_CLIENT_ID=
RECEIVER_CLIENT_SECRET=
# Destination id of the simulated Meldeamt; submissions are addressed here
RECEIVER_DESTINATION_ID=
# Private keys of the Meldeamt destination as JWK JSON files — created with
#   ./gradlew run --args="genkeys"
# (same file names the official FIT-Connect tooling uses). Upload the two matching
# keys/publicKey_*.jwk.json files to the Zustellpunkt's "Sicherheit" section in the portal.
RECEIVER_DECRYPTION_JWK_FILE=keys/privateKey_decryption.jwk.json
RECEIVER_SIGNATURE_JWK_FILE=keys/privateKey_signing.jwk.json

# --- Addressing (must match what the Meldeamt destination registers in the portal!) ----------
# Verwaltungsleistung (Leika URN) the destination is registered for
SERVICE_IDENTIFIER=urn:de:fim:leika:leistung:99400048079000
SERVICE_NAME=Meldeauskunft anfordern (Demo)
# Region (ARS, with DE prefix) the destination is registered for
SERVICE_REGION=

# --- Fachdaten schemas (faked; the URIs must be registered as submission schemas on the destination)
DATA_SCHEMA_URI=https://demo.example.dev/schemas/xmeld/meldeauskunft-anfrage/1.0
REPLY_SCHEMA_URI=https://demo.example.dev/schemas/xmeld/meldeauskunft-antwort/1.0

# --- Behaviour ---------------------------------------------------------------------------------
# Seconds between polls in `receive --loop` mode
POLL_INTERVAL_SECONDS=5
